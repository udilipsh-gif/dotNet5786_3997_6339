<Window x:Class="PL.StartDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        mc:Ignorable="d" 
        Title="בחירת הזמנה"
        Loaded="StartDeliveryWindow_Loaded"
        Closed="StartDeliveryWindow_Closed"
        Height="450" Width="840">
    <Window.Resources>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />

        <!-- Style לתאים עם Wrap -->
        <Style x:Key="WrappedTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Style לשורות -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- Style לכותרות עם Wrap -->
        <Style x:Key="WrappedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="4,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="סוג משלוח:" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="5"/>
            <ComboBox Grid.Column="1"
                   ItemsSource="{Binding EnumTypeOfOrder}"
                   DisplayMemberPath="Name"
                   SelectedValuePath="Id"
                   SelectedValue="{Binding SelectedFilter}"
                   SelectionChanged="ComboBox_SelectionChanged"
                   SelectedIndex="0"
                   FontSize="14"
                   Width="150"
                   Margin="5"
                   ToolTip="בחר סוג משלוח להצגה בטבלה">
            </ComboBox>
        </Grid>


        <DataGrid Grid.Row="1"
          x:Name="OrdersGrid"
          AutoGenerateColumns="False"
          Margin="5"
          ItemsSource="{Binding DeliveryListView}"
          ToolTip="טבלת הזמנות - הצג, מיין וסנן מידע על הזמנות"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectionChanged="OrdersGrid_SelectionChanged"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          HorizontalScrollBarVisibility="Auto"
          FlowDirection="RightToLeft"
          EnableRowVirtualization="False"
          EnableColumnVirtualization="False">
            
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="איסוף" Width="Auto">
                    
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="איסוף"
                                    Click="CollectOrder_Click"
                                    Padding="8,4"
                                    Margin="2"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    Cursor="Hand"
                                    ToolTip="לחץ לאיסוף ההזמנה"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                
                <DataGridTextColumn Header="מזהה הזמנה"
                            Binding="{Binding OrderId}"
                            SortMemberPath="OrderId"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סוג הזמנה"
                            Binding="{Binding TypeOfOrder}"
                            SortMemberPath="TypeOfOrder"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>
                

                <DataGridTextColumn Header=" מרחק אווירי"
                                Binding="{Binding DistanceKm, StringFormat=N2}"
                                SortMemberPath="DistanceKm"
                                Width="Auto"
                                HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מרחק בפועל"
                            Binding="{Binding ActualDistance}"
                            SortMemberPath="TypeOfOrder"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="משקל"
                            Binding="{Binding Weight}"
                            SortMemberPath="TypeOfOrder"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="הערכת זמן"
                            Binding="{Binding EstimatedDeliveryTime}"
                            SortMemberPath="TypeOfOrder"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סטטוס עמידה בזמנים"
                            Binding="{Binding ScheduleStatus}"
                            SortMemberPath="ScheduleStatus"
                            Width="Auto"
                            ElementStyle="{StaticResource WrappedTextCellStyle}"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="זמן לסיום"
                            Binding="{Binding TimeLeftForDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                            SortMemberPath="TimeLeftForDelivery"
                            Width="Auto"
                            HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סך זמן השלמת הטיפול"
                                Binding="{Binding TotalTimeOfDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                                SortMemberPath="TotalTimeOfDelivery"
                                Width="Auto"
                                HeaderStyle="{StaticResource WrappedHeaderStyle}"/>
                
            </DataGrid.Columns>
        </DataGrid>


    </Grid>
</Window>
