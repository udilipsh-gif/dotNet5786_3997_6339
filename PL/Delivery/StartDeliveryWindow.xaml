<Window x:Class="PL.StartDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="בחירת הזמנה"
        Loaded="StartDeliveryWindow_Loaded"
        Closed="StartDeliveryWindow_Closed"
        Height="450" 
        SizeToContent="Width"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="DataGridRow_PreviewMouseLeftButtonUp"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="סוג משלוח:" Style="{StaticResource ModernLabel}" FontSize="16"/>

            <ComboBox Width="200"
                      Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding EnumTypeOfOrder}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedFilter}"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedIndex="0"
                      ToolTip="בחר סוג משלוח להצגה בטבלה"/>
        </StackPanel>
        
        

        <DataGrid Grid.Row="1"
                  x:Name="OrdersGrid"
                  ItemsSource="{Binding DeliveryListView}"
                  ToolTip="טבלת הזמנות - הצג, מיין וסנן מידע על הזמנות"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FlowDirection="RightToLeft">


            <DataGrid.Columns>

                <DataGridTemplateColumn Header="פעולה" Width="Auto" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="איסוף"
                                    Click="CollectOrder_Click"
                                    Height="30"
                                    Width="70"
                                    Padding="0"
                                    Margin="2"
                                    FontSize="12"
                                    Background="#4CAF50" 
                                    Foreground="White"
                                    ToolTip="לחץ לאיסוף ההזמנה">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="מזהה"
                                    Binding="{Binding OrderId}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="סוג"
                                    Binding="{Binding TypeOfOrder, Converter={StaticResource EnumDescriptionConverter}}"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrappedTextCellStyle}">
                            <Setter Property="Background" Value="{Binding TypeOfOrder, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                </DataGridTextColumn>

                <DataGridTextColumn Header="כתובת איסוף"
                     Binding="{Binding Path=DataContext.StoreAddress, RelativeSource={RelativeSource AncestorType=Window}  }"
                     Width="Auto"/>

                <DataGridTextColumn Header="כתובת נמען"
                     Binding="{Binding Address}"
                     Width="Auto"/>


                <DataGridTextColumn Header="מרחק אווירי"
                                    Binding="{Binding DistanceKm, StringFormat=N2}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="מרחק בפועל"
                                    Binding="{Binding ActualDistance}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="משקל"
                                    Binding="{Binding Weight}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="הערכת זמן"
                                    Binding="{Binding EstimatedDeliveryTime, Converter={StaticResource TimeSpanConverter}}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="סטטוס"
                                    Binding="{Binding ScheduleStatus, Converter={StaticResource EnumDescriptionConverter}}"
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrappedTextCellStyle}">
                            <Setter Property="Background" Value="{Binding ScheduleStatus, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="זמן לסיום"
                                    Binding="{Binding TimeLeftForDelivery, Converter={StaticResource TimeSpanConverter}}"
                                    Width="Auto"/>

                <DataGridTextColumn Header="זמן כולל"
                                    Binding="{Binding MaxDeliveryTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"
                                    Width="Auto"/>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" 
                    Visibility="{Binding OrderListEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="אין הזמנות ברשימה" ></TextBlock>
        </StackPanel>
    </Grid>
</Window>