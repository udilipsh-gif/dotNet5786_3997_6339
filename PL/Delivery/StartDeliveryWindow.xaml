<Window x:Class="PL.StartDeliveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="בחר משלוח לביצוע"
        Loaded="StartDeliveryWindow_Loaded"
        Closed="StartDeliveryWindow_Closed"
        Height="500" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="הצג משלוחים מסוג:" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox ItemsSource="{Binding EnumTypeOfOrder}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedFilter}"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedIndex="0"
                      Width="200"
                      Height="35"
                      Margin="10,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="OrdersGrid"
                  ItemsSource="{Binding DeliveryListView}"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="אסוף 📦"
                                    Click="CollectOrder_Click"
                                    Background="#4CAF50"
                                    Padding="5"
                                    Height="30"
                                    FontSize="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="מזהה" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="סוג" Binding="{Binding TypeOfOrder}" Width="Auto"/>
                <DataGridTextColumn Header="מרחק (ק״מ)" Binding="{Binding DistanceKm, StringFormat=N2}" Width="Auto"/>
                <DataGridTextColumn Header="כתובת" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="זמן משוער" Binding="{Binding EstimatedDeliveryTime, Converter={StaticResource TimeSpanConverter}}" Width="Auto"/>
                <DataGridTextColumn Header="זמן שנותר" Binding="{Binding TimeLeftForDelivery, Converter={StaticResource TimeSpanConverter}}" FontWeight="Bold" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>