<Window x:Class="PL.CloseDeliveryWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        FlowDirection="RightToLeft"
        Title="סיום משלוח" 
        Height="200" Width="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- כותרת -->
        <TextBlock Grid.Row="0" 
                   Text="בחר סיבת סיום המשלוח:" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- רשימת בחירה -->
        <ComboBox Grid.Row="1" 
                  x:Name="EndDeliveryComboBox"
                  ItemsSource="{Binding EndDeliveryOptions}"
                  SelectedItem="{Binding SelectedEndDelivery}"
                  FontSize="14"
                  Padding="10"
                  VerticalAlignment="Top"/>

        <!-- כפתורי אישור וביטול -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button Content="אישור" 
                    Width="100" 
                    Height="35"
                    Margin="5"
                    Click="OkButton_Click"
                    IsDefault="True"/>
            <Button Content="ביטול" 
                    Width="100" 
                    Height="35"
                    Margin="5"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
