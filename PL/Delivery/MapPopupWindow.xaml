<Window x:Class="PL.MapPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מיקום ההזמנה"
        Width="420" Height="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated"
        FlowDirection="RightToLeft">

    <Border Background="White" 
            BorderBrush="#2196F3" 
            BorderThickness="2" 
            CornerRadius="8"
            Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- כותרת -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="🗺️" FontSize="20" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Order.OrderId, StringFormat='הזמנה מספר {0}'}" 
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="✕" 
                        HorizontalAlignment="Left" 
                        Margin="10,0,0,0"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </StackPanel>

            <!-- מפה -->
            <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="4">
                <Grid>
                    <!-- תמונת המפה -->
                    <Image Source="{Binding MapImageUrl}" 
                           Stretch="Uniform"
                           Visibility="{Binding MapImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                    
                    <!-- Fallback אם אין מפה -->
                    <StackPanel VerticalAlignment="Center" 
                                HorizontalAlignment="Center"
                                Visibility="{Binding MapImageUrl, Converter={StaticResource NullToVisibilityConverter},ConverterParameter='Invert'}">
                        <TextBlock Text="📍" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Order.Address}" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- מידע על המסלול -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock Text="{Binding Order.Address}" 
                           FontSize="13" 
                           TextWrapping="Wrap"
                           Foreground="#333"/>
                <TextBlock Text="{Binding RouteInfo}" 
                           FontSize="12" 
                           Foreground="#666"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- כפתור איסוף -->
            <Button Grid.Row="3" 
                    Content="אסוף הזמנה זו"
                    Background="#4CAF50"
                    Foreground="White"
                    Padding="15,8"
                    Margin="0,10,0,0"
                    Cursor="Hand"
                    Click="CollectButton_Click"/>
        </Grid>
    </Border>
</Window>