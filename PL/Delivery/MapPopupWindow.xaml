<Window x:Class="PL.MapPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="מיקום ההזמנה"
        Width="400" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Deactivated="Window_Deactivated"
        FlowDirection="RightToLeft">

    <Border Background="White" 
            BorderBrush="{StaticResource PrimaryColor}" 
            BorderThickness="1" 
            CornerRadius="10"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.4" Color="#333"/>
        </Border.Effect>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📍" FontSize="20" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Order.OrderId, StringFormat='מיקום הזמנה #{0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Left" Click="CloseButton_Click" Background="Transparent" Foreground="Gray" BorderThickness="0" Padding="5" FontSize="16"/>
            </Grid>

            <Border Grid.Row="1" Background="#E1F5FE" CornerRadius="5" ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding MapImageUrl}" Stretch="UniformToFill" Visibility="{Binding MapImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding MapImageUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}">
                        <TextBlock Text="🗺️" FontSize="40" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Order.Address}" TextWrapping="Wrap" TextAlignment="Center" Margin="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,15,0,0">
                <TextBlock Text="{Binding RouteInfo}" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button Content="אסוף הזמנה זו" Click="CollectButton_Click" Background="#4CAF50" Height="40"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>