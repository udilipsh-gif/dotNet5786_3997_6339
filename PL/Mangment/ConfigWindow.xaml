<Window x:Class="PL.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="הגדרות מערכת" 
        Height="650" Width="700"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Loaded="ConfigWindow_Loaded"
        Closed="ConfigWindow_Close"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="MinHeight" Value="25"/>
            <Setter Property="MaxHeight" Value="100"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="עריכת הגדרות מערכת" Style="{StaticResource HeaderTextStyle}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>

                <TextBlock Text="פרטי מנהל וכללי" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,10,0,5"/>
                <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">

                    <UniformGrid Columns="2" VerticalAlignment="Top">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="מזהה מנהל:"/>
                            <TextBox Grid.Column="1" Text="{Binding Configuration.ManagerId, Mode=TwoWay}" MaxLength="9" local:Tools.NumericOnly="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="סיסמת מנהל:"/>
                            <TextBox Grid.Column="1" Text="{Binding Configuration.PasswordManager, Mode=TwoWay}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="כתובת חנות:"/>
                            <TextBox Grid.Column="1" Text="{Binding Configuration.StoreAddress, Mode=TwoWay}"/>
                        </Grid>
                    </UniformGrid>
                </Border>
                
                
                <TextBlock Text="מהירויות כלי רכב (קמ״ש)" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,20,0,5"/>
                <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,10">
                            <Label Content="רכב:"/>
                            <TextBox Text="{Binding Configuration.AvgSpeedCar, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                            <Label Content="אופנוע:"/>
                            <TextBox Text="{Binding Configuration.AvgSpeedMotorcycle, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <Label Content="אופניים:"/>
                            <TextBox Text="{Binding Configuration.AvgSpeedBike, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <Label Content="הליכה:"/>
                            <TextBox Text="{Binding Configuration.AvgSpeedFoot, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="לוגיקה וזמנים" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,20,0,5"/>
                <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="מרחק משלוח מירבי:"/>
                            <TextBox Grid.Column="1" Text="{Binding Configuration.MaxDeliveryRange, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="זמן משלוח מקסימלי:"/>
                            <local:TimeSpanInput Grid.Column="1" Value="{Binding Configuration.MaxDeliveryTime}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="טווח סיכון:" ToolTip="מתי המערכת מתריעה על איחור"/>
                            <local:TimeSpanInput Grid.Column="1" Value="{Binding Configuration.RiskRange}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="זמן חוסר פעילות (שליח):"/>
                            <local:TimeSpanInput Grid.Column="1" Value="{Binding Configuration.MaxTimeInactivity}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="טוקנים וסיסמאות" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="0,20,0,5"/>
                <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15">
                    <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="טוקן סקריפט:"/>
                        <TextBox Grid.Column="1" Text="{Binding Configuration.ScriptUrl, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="סיסמה לסקריפט:"/>
                        <TextBox Grid.Column="1" Text="{Binding Configuration.ScriptPass, Mode=TwoWay}"/>

                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="טוקן שיחות/סמס:"/>
                        <TextBox Grid.Column="1" Text="{Binding Configuration.TokenCallSms, Mode=TwoWay}"/>
                    </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="שמור שינויים" Click="BtuSave_Click" Width="150"/>
            <Button Content="ביטול" Click="BtnCancel_Click" Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
        </StackPanel>
    </Grid>
</Window>