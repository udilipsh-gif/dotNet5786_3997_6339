<Window x:Class="PL.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Height="800" Width="900" 
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="ניהול המערכת" MinHeight="300" MinWidth="450"
        Loaded="ManagerWindow_Loaded"
        Closed="ManagerWindow_Close">
    <Window.Resources>
        <!-- Converter for TimeSpan to string format (DD:HH) and back -->
        <local:SpanTimeConverter x:Key="SpanTimeConverter" />

        <Style TargetType="Label" x:Key="UniformLabel">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Style for text boxes: Center-aligned vertically, stretches horizontally -->
        <Style x:Key="CommonInputStyle" TargetType="Control">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style TargetType="TextBox" x:Key="UniformTextBox" BasedOn="{StaticResource CommonInputStyle}" >
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <EventSetter Event="TextChanged" Handler="TextBox_TextChanged"/>
            <EventSetter Event="LostFocus" Handler="TextBox_LostFocus"/>
        </Style>

        <Style TargetType="TextBox" x:Key="UniformTextBoxNom" BasedOn="{StaticResource CommonInputStyle}" >
            <Setter Property="local:Tools.NumericOnly" Value="True"/>
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
            <EventSetter Event="TextChanged" Handler="TextBox_TextChanged"/>
            <EventSetter Event="LostFocus" Handler="TextBox_LostFocus"/>
        </Style>
        <Style TargetType="local:TimeSpanInput" x:Key="UniformSpanTime" >
            <EventSetter Event="TextBox.GotFocus" Handler="TextBox_GotFocus"/>
            <EventSetter Event="TextBox.TextChanged" Handler="TextBox_TextChanged"/>
            <EventSetter Event="TextBox.LostFocus" Handler="TextBox_LostFocus"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top-left section: Store name, clock display, and time advance buttons -->
        <Grid Grid.Row="0" Grid.Column="0"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Store name label -->
            <Label Grid.Row="0" Content="חנות הספרים שלי" Padding="5" Width="220"
                   Style="{StaticResource UniformLabel}"/>

            <!-- Current system clock display - Shows date and time in Hebrew locale -->
            <Label Grid.Row="1"  Language="he-IL" Content="{Binding CurrentTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontWeight="Bold" Padding="10,5" FontSize="20"/>

            <!-- Clock advance buttons - Each button advances the clock by different time units -->
            <WrapPanel Grid.Row="2" Margin="10,0">
                <!-- Advance clock by 1 minute -->
                <Button Margin="2,0" Content="דקה" Height="Auto" Width="Auto" Tag="Minute" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 hour -->
                <Button Margin="2,0" Content="שעה" Height="Auto" Width="Auto" Tag="Hour" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 day -->
                <Button Margin="2,0" Content="יום" Height="Auto" Width="Auto" Tag="Day" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 week -->
                <Button Margin="2,0" Content="שבוע" Height="Auto" Width="Auto" Tag="Week" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 month -->
                <Button Margin="2,0" Content="חודש" Height="Auto" Width="Auto" Tag="Month" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 year -->
                <Button Margin="2,0" Content="שנה" Height="Auto" Width="Auto" Tag="Year" Click="ClockForward_Click" BorderThickness="0"/>
            </WrapPanel>
        </Grid>

        <!-- Left section: Configuration editor with scrollable form -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="20">
            <ScrollViewer>
                <StackPanel>
                    <!-- Configuration section title -->
                    <TextBlock Text="עריכת הגדרות מערכת" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Manager ID field - Numeric only, max 9 digits -->
                    <Label Content="מזהה מנהל:" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.ManagerId, Mode=TwoWay }"
                       Style="{StaticResource UniformTextBoxNom}"
                       MaxLength="9"/>

                    <!-- Store address field -->
                    <Label Content="כתובת חנות:" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.StoreAddress, Mode=TwoWay}" 
                             Style="{StaticResource UniformTextBox}"/>

                    <!-- Latitude field - Read-only, populated from address lookup -->
                    <Label Content="קו רוחב:" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.Latitude, Mode=TwoWay}" 
                             Style="{StaticResource UniformTextBox}" IsReadOnly="True"/>

                    <!-- Longitude field - Read-only, populated from address lookup -->
                    <Label Content="קו אורך:" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.Longitude, Mode=TwoWay}" 
                             Style="{StaticResource UniformTextBox}" IsReadOnly="True"/>

                    <!-- Car average speed field - Numeric only, in km/h -->
                    <Label Content="מהירות רכב (קמ״ש):" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.AvgSpeedCar, Mode=TwoWay}" 
                      Style="{StaticResource UniformTextBoxNom}"/>

                    <!-- Motorcycle average speed field - Numeric only, in km/h -->
                    <Label Content="מהירות אופונוע (קמ״ש):" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.AvgSpeedMotorcycle, Mode=TwoWay}"
                      Style="{StaticResource UniformTextBoxNom}"/>

                    <!-- Bike average speed field - Numeric only, in km/h -->
                    <Label Content="מהירות אופניים (קמ״ש):" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.AvgSpeedBike, Mode=TwoWay}"
                      Style="{StaticResource UniformTextBoxNom}"/>

                    <!-- Walking average speed field - Numeric only, in km/h -->
                    <Label Content="מהירות הליכה (קמ״ש):" Style="{StaticResource UniformLabel}"/>
                    <TextBox Text="{Binding Configuration.AvgSpeedFoot, Mode=TwoWay}"
                             Style="{StaticResource UniformTextBoxNom}"/>

                    <!-- Maximum delivery time field - Uses converter for DD:HH format -->
                    <Label Content="זמן משלוח מקסימלי (ימים:שעות):" Style="{StaticResource UniformLabel}"/>
                    <local:TimeSpanInput Value="{Binding Configuration.MaxDeliveryTime}" 
                                         Style="{StaticResource UniformSpanTime}"/>

                    <!-- Risk range field - Uses converter for DD:HH format -->
                    <Label Content="טווח סיכון (ימים:שעות):" Style="{StaticResource UniformLabel}"/>
                    <local:TimeSpanInput Value="{Binding Configuration.RiskRange}" 
                                         Style="{StaticResource UniformSpanTime}"/>

                        <!-- Maximum inactivity time for courier field - Uses converter for DD:HH format -->
                    <Label Content="זמן חוסר פעילות לשליח:" Style="{StaticResource UniformLabel}"/>
                    <local:TimeSpanInput Value="{Binding Configuration.MaxTimeInactivity}" 
                                         Style="{StaticResource UniformSpanTime}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Top menu bar: Main navigation and action buttons -->
        <Menu Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="10,10">
            <!-- Reset database button - Clears all data -->
            <Button  Content="איפוס מערכת" Margin="10" Padding="5" Click="ResetDB"/>
            <!-- Initialize database button - Populates with sample data -->
            <Button  Content="אתחול מערכת" Margin="10" Padding="5" Click="InitDB"/>
            <!-- Courier management button - Opens courier list window -->
            <Button  Content="ניהול שליחים" Margin="10" Padding="5" Click="btnCourierList_Click"/>
            <!-- Order management button - To be implemented -->
            <Button  Content="ניהול הזמנות" ToolTip="טבלת הזמנות - הצג רשימה, מיין וסנן מידע על הזמנות" Margin="10" Padding="5" Click="btnOrderList_Click"/>
            <!-- Delivery management button - To be implemented -->
            <Button  Content="ניהול משלוחים" Margin="10" Padding="5" />
        </Menu>
    </Grid>
</Window>
