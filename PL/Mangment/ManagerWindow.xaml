<Window x:Class="PL.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Height="550" Width="500" 
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="ניהול המערכת" MinHeight="300" MinWidth="450"
        Loaded="ManagerWindow_Loaded"
        Closed="ManagerWindow_Close">
    <Window.Resources>
        <!-- Converter for TimeSpan to string format (DD:HH) and back -->
        <local:SpanTimeConverter x:Key="SpanTimeConverter" />

        <Style TargetType="Label" x:Key="UniformLabel">
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Background="WhiteSmoke">

        <Grid.RowDefinitions>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="120*"/>
            <RowDefinition Height="400*"/>
        </Grid.RowDefinitions>

        <!-- Top-left section: Store name, clock display, and time advance buttons -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Store name label -->
            <Label Grid.Row="0" Content="חנות הספרים שלי" Padding="5" Width="220"
                   Style="{StaticResource UniformLabel}"/>

            <!-- Current system clock display - Shows date and time in Hebrew locale -->
            <Label Grid.Row="1"  Language="he-IL" Content="{Binding CurrentTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" FontWeight="Bold" Padding="10,5" FontSize="20"/>

            <!-- Clock advance buttons - Each button advances the clock by different time units -->
            <WrapPanel Grid.Row="2" Margin="10,0">
                <!-- Advance clock by 1 minute -->
                <Button Margin="2,0" Content="דקה" Height="Auto" Width="Auto" Tag="Minute" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 hour -->
                <Button Margin="2,0" Content="שעה" Height="Auto" Width="Auto" Tag="Hour" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 day -->
                <Button Margin="2,0" Content="יום" Height="Auto" Width="Auto" Tag="Day" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 week -->
                <Button Margin="2,0" Content="שבוע" Height="Auto" Width="Auto" Tag="Week" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 month -->
                <Button Margin="2,0" Content="חודש" Height="Auto" Width="Auto" Tag="Month" Click="ClockForward_Click" BorderThickness="0"/>
                <!-- Advance clock by 1 year -->
                <Button Margin="2,0" Content="שנה" Height="Auto" Width="Auto" Tag="Year" Click="ClockForward_Click" BorderThickness="0"/>
            </WrapPanel>
        </Grid>

        <!-- Left section: Configuration editor with scrollable form -->
        <Grid Grid.Row="2" Margin="20">

        </Grid>

        <!-- Top menu bar: Main navigation and action buttons -->
        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,10">
       
            <!-- Courier management button - Opens courier list window -->
            <Button  Content="ניהול שליחים" Margin="10" Padding="5" Click="btnCourierList_Click"/>
            <!-- Order management button - To be implemented -->
            <Button  Content="ניהול הזמנות" ToolTip="טבלת הזמנות - הצג רשימה, מיין וסנן מידע על הזמנות" Margin="10" Padding="5" Click="btnOrderList_Click"/>
            <!-- Reset database button - Clears all data -->
            <Button  Content="איפוס" Margin="10" Padding="5" Click="ResetDB"/>
            <!-- Initialize database button - Populates with sample data -->
            <Button  Content="אתחול" Margin="10" Padding="5" Click="InitDB"/>
            <!-- Initialize database button - Populates with sample data -->
            <Button  Content="הגדרות" Margin="10" Padding="5" Click="btnConfig_Click"/>
        </StackPanel>
    </Grid>
</Window>
