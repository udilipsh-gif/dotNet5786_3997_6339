<Window x:Class="PL.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="ניהול המערכת" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        FlowDirection="RightToLeft"
        Loaded="ManagerWindow_Loaded"
        Closed="ManagerWindow_Close">

    <Grid IsEnabled="{Binding IsWindowEnabled}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="ניהול שליחים" Click="btnCourierList_Click" Width="120"/>
                <Button Content="ניהול הזמנות" Click="btnOrderList_Click" Width="120" ToolTip="טבלת הזמנות - הצג רשימה, מיין וסנן"/>
                <Button Content="הגדרות" Click="btnConfig_Click" Width="120"/>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <Button Content="איפוס נתונים" Click="ResetDB" Width="120" Style="{StaticResource DestructiveButtonStyle}"/>
                    <Button Content="אתחול נתונים" Click="InitDB" Width="120" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="חנות הספרים שלי - לוח בקרה" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Left"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,10">
                <TextBlock Text="שעון מערכת: " FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource SubTextColor}"/>
                <TextBlock Text="{Binding CurrentTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" 
                           Language="he-IL" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}"/>
            </StackPanel>

            <WrapPanel Grid.Row="2" Grid.Column="0" Margin="0,10">
                <TextBlock Text="הרץ זמן קדימה:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>

                <Button Content="דקה" Tag="Minute" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
                <Button Content="שעה" Tag="Hour" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
                <Button Content="יום" Tag="Day" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
                <Button Content="שבוע" Tag="Week" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
                <Button Content="חודש" Tag="Month" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
                <Button Content="שנה" Tag="Year" Click="ClockForward_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60"/>
            </WrapPanel>
            <Label Grid.Row="0" Grid.Column="1" Content="קצב התקדמות השעון:" 
                   Style="{StaticResource ModernLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ClockSpeed}" IsEnabled="{Binding RunStopSimulator}"/>
            <Button Grid.Row="2" Grid.Column="1" Click="btnSimulator_Click" 
                    Content="{Binding RunStopSimulator, Mode=OneWay, Converter={StaticResource RunStopSimulatorConverter}}"/>

        </Grid>

        <ScrollViewer Grid.Row="2" Margin="20,0,20,20" Padding="10">
            <ItemsControl ItemsSource="{Binding CombinedStatistics}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource StatisticButtonStyle}"
                        Click="btnStatistic_Click"
                        Tag="{Binding Id}"
                        Width="200"  
                        Margin="10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>