<Window x:Class="PL.CourierDeliveryHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        
       
        Title="היסטוריית משלוחים" Height="450" Width="630">
    

        <Window.Resources>
            <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>

         
            <Style x:Key="WrappedTextCellStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="5,2"/>
            </Style>

            <!-- Style לשורות -->
            <Style TargetType="DataGridRow">
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="MinHeight" Value="32"/>
            </Style>

            <!-- Style לכותרות עם Wrap -->
            <Style x:Key="WrappedHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="ContentTemplate" >
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                TextWrapping="Wrap"
                                TextAlignment="Center"
                                VerticalAlignment="Center"
                                 FontSize="14"
                                FontFamily="BOLD"
                                Margin="1,2"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Window.Resources>

    <Border Grid.Column="0"
          Margin="10"
          Padding="10"
          CornerRadius="10"
          Background="#F5F5F5"
          BorderBrush="#DDD"
          BorderThickness="1">


        <Grid>
                <!--3 שורות, סינון, תוכן, כפתור -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>


                </Grid.RowDefinitions>

                <!--<StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,10">
                    <StackPanel Margin="5,0">
                        <TextBlock Text="סנן לפי סוג:" Margin="0,0,0,3"/>
                        <ComboBox Width="150" 
                       ItemsSource="{Binding ScheduleStatusList}"
                       DisplayMemberPath="Name"
                       SelectedValuePath="Id"
                       SelectedValue="{Binding SelectedScheduleFilter}"
                       SelectionChanged="ComboBox_SelectionChanged">
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="5,0">
                        <TextBlock Text="סנן לפי סוג הזמנה:" Margin="0,0,0,3"/>
                        <ComboBox Width="150" 
                       ItemsSource="{Binding TypeOfOrderList}"
                       SelectedValue="{Binding SelectedTypeFilter}"
                       SelectionChanged="ComboBox_SelectionChanged"
                       DisplayMemberPath="Name"
                       SelectedValuePath="Id">
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="5,0">
                        <TextBlock Text="סנן לפי סטטוס הזמנה:" Margin="0,0,0,3"/>
                        <ComboBox Width="150" 
                       ItemsSource="{Binding TypeOfOrderStatusList}"
                       SelectedValue="{Binding SelectedOrderStatusFilter}"
                       SelectionChanged="ComboBox_SelectionChanged"
                       DisplayMemberPath="Name"
                       SelectedValuePath="Id">
                        </ComboBox>
                    </StackPanel>-->

                <!--</StackPanel>-->



                <!-- DataGrid להצגת ההזמנות -->
            <DataGrid Grid.Row="1"
               AutoGenerateColumns="False"
               Margin="5"
               ItemsSource="{Binding DeliveriesHistory}"
               ToolTip="טבלת היסטוריית משלוחים "
               IsReadOnly="True"
               SelectionMode="Single"
               CanUserAddRows="False"
               CanUserDeleteRows="False"
               HorizontalScrollBarVisibility="Auto"
               FlowDirection="RightToLeft"
               EnableRowVirtualization="False"
               EnableColumnVirtualization="False">


                <DataGrid.Columns>
                    <DataGridTextColumn Header="מזהה הזמנה"
                                 Binding="{Binding OrderId}"
                                 SortMemberPath="OrderId"
                                 Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                 HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    <DataGridTextColumn Header="סוג הזמנה"
                                 Binding="{Binding OrderType, Converter={StaticResource EnumDescriptionConverter}}"
                                 SortMemberPath="OrderStatus"
                                 Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                 HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    <DataGridTextColumn Header=" כתובת"
                                 Binding="{Binding Address}"
                                 SortMemberPath="DeliveryId"
                                 Width="auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                 HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    <DataGridTextColumn Header="סוג שילוח"
                                 Binding="{Binding ShipmentType, Converter={StaticResource EnumDescriptionConverter}}"
                                 SortMemberPath="TypeOfOrder"
                                 Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                 HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    <DataGridTextColumn Header="מרחק"
                                     Binding="{Binding ActualDistens, StringFormat=N2}"
                                     SortMemberPath="DistanceKm"
                                     Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                     HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    <DataGridTextColumn Header="סטטוס  סיום"
                                 Binding="{Binding EndDelivery, Converter={StaticResource EnumDescriptionConverter}}"
                                 SortMemberPath="ScheduleStatus"
                                 Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                 HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    

                    <DataGridTextColumn Header="סך זמן השלמת הטיפול"
                                     Binding="{Binding TotalTimeOfDelivery}"
                                     SortMemberPath="TotalTimeOfDelivery"
                                     Width="Auto"
                                 ElementStyle="{StaticResource WrappedTextCellStyle}"
                                     HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                    

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</Window>
