<Window x:Class="PL.Order.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"

           DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
    mc:Ignorable="d"
    Title="הזמנה בודדת"
    Height="520" Width="350"
   
    MinHeight="520" MinWidth="350">

    <Window.Resources>

        <local:EnumToBooleanConverter x:Key="MyEnumConverter" />
        <!-- Style for labels: Center-aligned vertically, right-aligned horizontally -->
        <Style TargetType="Label" x:Key="UniformLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Style for text boxes: Center-aligned vertically, stretches horizontally -->
        <Style TargetType="TextBox" x:Key="UniformTextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

     
        <!-- Style for combo boxes: Center-aligned vertically -->
        <Style TargetType="ComboBox" x:Key="UniformComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- Style for radio buttons: Center-aligned vertically -->
        <Style TargetType="RadioButton" x:Key="UniformRadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5" />
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Scroll viewer to enable scrolling when window content exceeds available space -->
        <ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentOrder.Id, Mode=TwoWay}" 
                    Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="0" Grid.Column="1" Content=":מזהה הזמנה" Style="{StaticResource UniformLabel}"/>

                <!-- Row 1: Courier name field -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" FlowDirection="RightToLeft">

                    <RadioButton Content="סטנדרט" Margin="0,0,5,0"
                 IsChecked="{Binding CurrentOrder.TypeOfOrder, 
                             Converter={StaticResource MyEnumConverter},      
                             ConverterParameter=STANDART}"
                             Style="{StaticResource UniformRadioButton}" />

                    <RadioButton Content="מהיר"
                 IsChecked="{Binding CurrentOrder.TypeOfOrder, 
                             Converter={StaticResource MyEnumConverter},   
                             ConverterParameter=FAST_DELIVERY}"
                             Style="{StaticResource UniformRadioButton}" />

                    <RadioButton Content="מיידי" Margin="5,0,0,0"
                 IsChecked="{Binding CurrentOrder.TypeOfOrder, 
                             Converter={StaticResource MyEnumConverter},           
                             ConverterParameter=DELIVER_IMMEDIATELY}"
                             Style="{StaticResource UniformRadioButton}" />
                </StackPanel>

                <Label Grid.Row="1" Grid.Column="1" Content=":סוג הזמנה" Style="{StaticResource UniformLabel}"/>

                <!-- Row 2: Password field - Uses PasswordBox for secure input -->
                <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding CurrentOrder.Details, Mode=TwoWay}"
                 Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="2" Grid.Column="1" Content=":הערות" Style="{StaticResource UniformLabel}"/>

                <!-- Row 3: Phone number field - Allows numeric input only (max 10 digits) -->
                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding CurrentOrder.Addres, Mode=TwoWay}"
                Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="3" Grid.Column="1" Content=":כתובת" Style="{StaticResource UniformLabel}"/>

                <!-- Row 4: Email address field -->
                <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding CurrentOrder.Weight, Mode=TwoWay}"
                Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="4" Grid.Column="1" Content=":משקל" Style="{StaticResource UniformLabel}"/>

                <!-- Row 5: Maximum delivery distance field - Allows numeric input only -->
                <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding CurrentOrder.Distance, Mode=TwoWay}"
                   Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="5" Grid.Column="1" Content=":מרחק" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="6" Grid.Column="0" Text="{Binding CurrentOrder.Name, Mode=TwoWay}"
                Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="6" Grid.Column="1" Content=":שם" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="13" Grid.Column="0" Text="{Binding CurrentOrder.Phone, Mode=TwoWay}"
                 Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="13" Grid.Column="1" Content=":טלפון" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="7" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentOrder.OrderDate, StringFormat='{}{0:dd.MM.yyyy}', Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="7" Grid.Column="1" Content="זמן פתיחת הזמנה" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="8" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentOrder.EstimatedDeliveryTime, StringFormat='{}{0:dd.MM.yyyy}', Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="8" Grid.Column="1" Content="זמן אספקה צפוי" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="9" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentOrder.MaxDeliveryTime, StringFormat='{}{0:dd.MM.yyyy}', Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="9" Grid.Column="1" Content="זמן אספקה מירבי" Style="{StaticResource UniformLabel}"/>

                <ComboBox Grid.Row="10" Grid.Column="0" ItemsSource="{Binding OrderStatusValues}" SelectedItem="{Binding CurrentOrder.OrderStatus, Mode=TwoWay}" Style="{StaticResource UniformComboBox}"/>
                
                
                <Label Grid.Row="10" Grid.Column="1" Content=":סטטוס הזמנה" Style="{StaticResource UniformLabel}"/>

                <ComboBox Grid.Row="11" Grid.Column="0" ItemsSource="{Binding ScheduleStatusValues}" SelectedItem="{Binding CurrentOrder.ScheduleStatus, Mode=TwoWay}" Style="{StaticResource UniformComboBox}"/>
                <Label Grid.Row="11" Grid.Column="1" Content="סטטוס עמידה בזמנים" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="12" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentOrder.TimeLeftForDelivery, StringFormat='{}{0:dd.MM.yyyy}', Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="12" Grid.Column="1" Content="זמן שנותר לסיום ההזמנה" Style="{StaticResource UniformLabel}"/>










            </Grid>

        </ScrollViewer>
     </Grid>
</Window>
