<Window x:Class="PL.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="רשימת הזמנות"
        FlowDirection="RightToLeft"
        Height="600" Width="1050"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ניהול הזמנות" Style="{StaticResource HeaderTextStyle}"/>

            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">

                    <StackPanel Margin="10,0">
                        <Label Content="סטטוס עמידה בזמנים:"/>
                        <ComboBox Width="180" 
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding ScheduleStatusList}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedScheduleFilter}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <Label Content="סוג הזמנה:"/>
                        <ComboBox Width="180" 
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding TypeOfOrderList}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedTypeFilter}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <Label Content="סטטוס הזמנה:"/>
                        <ComboBox Width="180" 
                          Style="{StaticResource ModernComboBox}"
                          ItemsSource="{Binding TypeOfOrderStatusList}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedOrderStatusFilter}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding OrderList}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FlowDirection="RightToLeft"
                  MouseDoubleClick="Add_Edit_Order_Click">

            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה" Binding="{Binding OrderId}" Width="Auto"/>

                <DataGridTextColumn Header="סטטוס" 
                                    Binding="{Binding OrderStatus, Converter={StaticResource EnumDescriptionConverter}}" 
                                    Width="Auto" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrappedTextCellStyle}">
                            <Setter Property="Background" Value="{Binding OrderStatus, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="משלוח" Binding="{Binding DeliveryId}" Width="Auto"/>

                <DataGridTextColumn Header="סוג" 
                                    Binding="{Binding TypeOfOrder, Converter={StaticResource EnumDescriptionConverter}}" 
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrappedTextCellStyle}">
                            <Setter Property="Background" Value="{Binding TypeOfOrder, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="מרחק (ק״מ)" 
                                    Binding="{Binding DistanceKm, StringFormat=N2}" 
                                    Width="90"/>

                <DataGridTextColumn Header="מצב לו''ז" 
                                    Binding="{Binding ScheduleStatus, Converter={StaticResource EnumDescriptionConverter}}" 
                                    Width="Auto">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrappedTextCellStyle}">
                            <Setter Property="Background" Value="{Binding ScheduleStatus, Converter={StaticResource StatusToColorConverter}}"/>
                            <Setter Property="Padding" Value="10,2"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="זמן לסיום" 
                                    Binding="{Binding TimeLeftForDelivery, Converter={StaticResource TimeSpanConverter}}" 
                                    Width="120"/>

                <DataGridTextColumn Header="זמן טיפול כולל" 
                                    Binding="{Binding TotalTimeOfDelivery, Converter={StaticResource TimeSpanConverter}}" 
                                    Width="120"/>

                <DataGridTextColumn Header="ניסיונות" Binding="{Binding NumberOfDeliveryAttempts}" Width="70"/>

                <DataGridTemplateColumn Header="ביטול" Width="*" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--<StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center">
                                
                                <Button Content="בטל" 
                                    Click="btnCancelOrder_Click" 
                                    Style="{StaticResource GhostDestructiveButtonStyle}"
                                    Width="60"
                                    Margin="0"
                                    IsEnabled="{Binding OrderStatus, Converter={StaticResource OrderStatusToCancelConverter}}"
                                    CommandParameter="{Binding IsChecked, ElementName=chkSms}"/>
                                <CheckBox x:Name="chkSms" 
                                      Content="שלח סמס" 
                                      Visibility="{Binding OrderStatus, Converter={StaticResource OrderStatusToVisibilityConverter}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,10,0"/>
                            </StackPanel>-->
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="1"
                                        Content="בטל" 
                                        Click="btnCancelOrder_Click" 
                                        Style="{StaticResource GhostDestructiveButtonStyle}"
                                        Width="60"
                                        Margin="0"
                                        IsEnabled="{Binding OrderStatus, Converter={StaticResource OrderStatusToCancelConverter}}"
                                        CommandParameter="{Binding IsChecked, ElementName=chkSms}"/>

                                <CheckBox Grid.Column="2"
                                          x:Name="chkSms" 
                                          Content="שלח סמס" 
                                          Visibility="{Binding OrderStatus, Converter={StaticResource OrderStatusToVisibilityConverter}}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right" 
                                          Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" 
                Content="+ הוסף הזמנה חדשה" 
                HorizontalAlignment="Right" 
                Width="180" 
                Height="40"
                Margin="0,15,0,0"
                Click="Add_Edit_Order_Click"/>
    </Grid>
</Window>