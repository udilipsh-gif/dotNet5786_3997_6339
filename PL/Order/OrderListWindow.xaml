<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="רשימת הזמנות"
        Height="450" Width="900" Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ComboBox לסינון לפי סטטוס -->
        <local:OrderFilterScheduleStatus x:Key="OrderFilterScheduleStatusKey" />

        <!-- ComboBox לסינון לפי סוג הזמנה -->
        <local:OrderFilterTypeOfOrder x:Key="OrderFilterTypeOfOrderKey" />
      

        <!-- Style לתאים עם Wrap -->
        <Style x:Key="WrappedTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Style לשורות -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- Style לכותרות עם Wrap -->
        <Style x:Key="WrappedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--3 שורות, סינון, תוכן, כפתור -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            

        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="0,0,0,10">
            <StackPanel Margin="5,0">
                <TextBlock Text="סנן לפי סטטוס עמידה בזמנים:" Margin="0,0,0,3"/>
                <ComboBox Width="150" 
                          ItemsSource="{Binding Source={StaticResource OrderFilterScheduleStatusKey}}"
                          SelectedValue="{Binding ScheduleStatusFilter, Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Margin="5,0">
                <TextBlock Text="סנן לפי סוג הזמנה:" Margin="0,0,0,3"/>
                <ComboBox Width="150" 
                          ItemsSource="{Binding Source={StaticResource OrderFilterTypeOfOrderKey}}"
                          SelectedValue="{Binding TypeOfOrderFilter, Mode=TwoWay}"
                          SelectionChanged="ComboBox_SelectionChanged"/>
            </StackPanel>

        </StackPanel>



        <!-- DataGrid להצגת ההזמנות -->
        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="5"
                  ItemsSource="{Binding OrderList}"
                  ToolTip="טבלת הזמנות - הצג, מיין וסנן מידע על הזמנות"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HorizontalScrollBarVisibility="Auto"
                  FlowDirection="RightToLeft"
                  EnableRowVirtualization="False"
                  EnableColumnVirtualization="False"
                  MouseDoubleClick="Add_Edit_Order_Click">

            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה הזמנה"
                                    Binding="{Binding OrderId}"
                                    SortMemberPath="OrderId"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סטטוס הזמנה"
                                    Binding="{Binding OrderStatus}"
                                    SortMemberPath="OrderStatus"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מזהה משלוח"
                                    Binding="{Binding DeliveryId}"
                                    SortMemberPath="DeliveryId"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סוג הזמנה"
                                    Binding="{Binding TypeOfOrder}"
                                    SortMemberPath="TypeOfOrder"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מרחק"
                                        Binding="{Binding DistanceKm, StringFormat=N2}"
                                        SortMemberPath="DistanceKm"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סטטוס עמידה בזמנים"
                                    Binding="{Binding ScheduleStatus}"
                                    SortMemberPath="ScheduleStatus"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="זמן לסיום"
                                    Binding="{Binding TimeLeftForDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                                    SortMemberPath="TimeLeftForDelivery"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סך זמן השלמת הטיפול"
                                        Binding="{Binding TotalTimeOfDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                                        SortMemberPath="TotalTimeOfDelivery"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מספר ניסיונות משלוח"
                                        Binding="{Binding NumberOfDeliveryAttempts}"
                                        SortMemberPath="NumberOfDeliveryAttempts"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTemplateColumn Header="ביטול" Width="Auto" HeaderStyle="{StaticResource WrappedHeaderStyle}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="בטל" 
                            Click="btnCancelOrder_Click" 
                            Padding="5,2" 
                            Margin="2"
                            ToolTip="לחץ כאן לביטול הזמנה"
                            Background="Green">


                                <Button.Style>
                                    <Style TargetType="Button">



                                        <Setter Property="IsEnabled" Value="False"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding OrderStatus}" Value="OPEN">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding OrderStatus}" Value="REFUSED">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>

                                            <DataTrigger Binding="{Binding OrderStatus}" Value="DELIVERING">
                                                <Setter Property="IsEnabled" Value="True"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>

                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <!-- Add Button: Opens a window to add a new order to the system -->
        <Button Content="הוסף הזמנה" 
            Grid.Row="2" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom" 
            Height="35"        
            Margin="10,20"         
            Width="100"
            Click="Add_Edit_Order_Click"
            ToolTip="לחץ כאן להוספת הזמנה למערכת"
            AutomationProperties.Name="כפתור הוספת הזמנה"/>
    </Grid>
</Window>
