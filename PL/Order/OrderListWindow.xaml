<Window x:Class="PL.Order.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL.Order"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="רשימת הזמנות"
        Height="450"
        Width="900">

    <Window.Resources>
        <!-- Style לתאים עם Wrap -->
        <Style x:Key="WrappedTextCellStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,2"/>
        </Style>

        <!-- Style לשורות -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- Style לכותרות עם Wrap -->
        <Style x:Key="WrappedHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="4,2"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- הגדרת שורות: שורה 0 = ComboBox, שורה 1 = DataGrid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ComboBox לסינון לפי סטטוס -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Label Content="סינון לפי סטטוס:" VerticalAlignment="Center"/>
            <ComboBox x:Name="StatusComboBox"
                      Width="150"
                      SelectionChanged="StatusComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- DataGrid להצגת ההזמנות -->
        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  Margin="5"
                  ItemsSource="{Binding OrderList}"
                  ToolTip="טבלת הזמנות - הצג, מיין וסנן מידע על הזמנות"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HorizontalScrollBarVisibility="Auto"
                  FlowDirection="RightToLeft"
                  EnableRowVirtualization="False"
                  EnableColumnVirtualization="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה הזמנה"
                                    Binding="{Binding OrderId}"
                                    SortMemberPath="Id"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סטטוס הזמנה"
                                    Binding="{Binding OrderStatus}"
                                    SortMemberPath="OrderStatus"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מזהה משלוח"
                                    Binding="{Binding DeliveryId}"
                                    SortMemberPath="DeliveryId"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סוג הזמנה"
                                    Binding="{Binding TypeOfOrder}"
                                    SortMemberPath="TypeOfOrder"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מרחק"
                                        Binding="{Binding DistanceKm}"
                                        SortMemberPath="DistanceKm"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סטטוס עמידה בזמנים"
                                    Binding="{Binding ScheduleStatus}"
                                    SortMemberPath="ScheduleStatus"
                                    Width="Auto"
                                    ElementStyle="{StaticResource WrappedTextCellStyle}"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="זמן לסיום"
                                    Binding="{Binding TimeLeftForDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                                    SortMemberPath="TimeLeftForDelivery"
                                    Width="Auto"
                                    HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="סך זמן השלמת הטיפול"
                                        Binding="{Binding TotalTimeOfDelivery, StringFormat='{}{0:dd/MM/yyyy}'}"
                                        SortMemberPath="TotalTimeOfDelivery"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>

                <DataGridTextColumn Header="מספר ניסיונות משלוח"
                                        Binding="{Binding NumberOfDeliveryAttempts}"
                                        SortMemberPath="NumberOfDeliveryAttempts"
                                        Width="Auto"
                                        HeaderStyle="{StaticResource WrappedHeaderStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
