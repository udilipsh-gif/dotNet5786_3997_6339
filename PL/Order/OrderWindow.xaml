<Window x:Class="PL.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="פרטי הזמנה"
        Height="650"
        SizeToContent="Width"
        WindowStartupLocation="CenterScreen"
        Loaded="OrderWindow_Loaded"
        Closed="OrderWindow_Closed"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" 
                Margin="20,0" 
                Background="{StaticResource SurfaceColor}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" 
                CornerRadius="8"
                Padding="15"
                Width="200"
                Visibility="{Binding CurrentOrder.DeliveryPerOrderInLists, Converter={StaticResource NullToVisibilityConverter}}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="היסטוריית משלוחים" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryColor}" 
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding CurrentOrder.DeliveryPerOrderInLists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" 
                                        Padding="10" 
                                        Background="#FAFAFA"
                                        BorderBrush="{StaticResource BorderColor}" 
                                        BorderThickness="1" 
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="שליח:" FontWeight="Bold" Margin="0,0,5,2"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CourierName}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="רכב:" FontWeight="Bold" Margin="0,0,5,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TypeShipment, Converter={StaticResource EnumDescriptionConverter}}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="התחלה:" FontWeight="Bold" Margin="0,0,5,2"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="סיום:" FontWeight="Bold" Margin="0,0,5,2"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimeEndDelivery, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="סטטוס:" FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EndDelivery}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="0" 
                Background="{StaticResource SurfaceColor}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Width="500"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="פרטי הזמנה" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="שם הלקוח:"/>
                        <TextBox Text="{Binding CurrentOrder.Name, Mode=TwoWay}"/>

                        <Label Content="טלפון:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding CurrentOrder.Phone, Mode=TwoWay}" local:Tools.NumericOnly="True"/>

                        <Label Content="כתובת:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding CurrentOrder.Addres, Mode=TwoWay}"/>

                        <Label Content="דחיפות:" Margin="0,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <RadioButton Content="רגיל" GroupName="Priority" Margin="10,0" 
                                         IsChecked="{Binding CurrentOrder.TypeOfOrder, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=STANDART, Mode=TwoWay}"/>
                            <RadioButton Content="מהיר" GroupName="Priority" Margin="10,0"
                                         IsChecked="{Binding CurrentOrder.TypeOfOrder, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=FAST_DELIVERY, Mode=TwoWay}"/>
                            <RadioButton Content="מיידי" GroupName="Priority" Margin="10,0"
                                         IsChecked="{Binding CurrentOrder.TypeOfOrder, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DELIVER_IMMEDIATELY, Mode=TwoWay}"/>
                        </StackPanel>

                        <Label Content="הערות:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding CurrentOrder.Details, Mode=TwoWay}" Height="60" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="סטטוס נוכחי:"/>
                        <TextBox Text="{Binding CurrentOrder.OrderStatus, Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True" Background="#F5F5F5" Foreground="Gray"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="זמן יצירה:"/>
                                <TextBox Text="{Binding CurrentOrder.OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" IsReadOnly="True" Background="#F5F5F5" Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="צפי אספקה:"/>
                                <TextBox Text="{Binding CurrentOrder.EstimatedDeliveryTime, StringFormat='{}{0:dd/MM/yyyy}'}" IsReadOnly="True" Background="#F5F5F5" Foreground="Gray"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="זמן מקסימלי למסירה:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding CurrentOrder.MaxDeliveryTime, Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True" Background="#F5F5F5" Foreground="Gray"/>

                        <Label Content="עמידה בזמנים:" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding CurrentOrder.ScheduleStatus, Converter={StaticResource EnumDescriptionConverter}}" IsReadOnly="True" Background="#F5F5F5" Foreground="Gray"/>

                        
                        
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="משקל:"/>
                                <TextBox Text="{Binding CurrentOrder.Weight, Mode=TwoWay}" local:Tools.NumericOnly="True"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="מרחק (ק״מ):"/>
                                <TextBox Text="{Binding CurrentOrder.Distance, StringFormat=N2, Mode=TwoWay}" IsReadOnly="True" Background="#F5F5F5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,30,0,0">
                    <Button Content="{Binding ButtonText, Converter={StaticResource ValueToHebrewConverter}}" 
                            Tag="{Binding ButtonText}"
                            Click="btnAddUpdate_Click"
                            Width="150"/>

                    <Button Content="בטל הזמנה" 
                            Click="btnCancel_Click"
                            CommandParameter="{Binding IsChecked, ElementName=chkSms}"
                            Width="150"
                            Margin="15,0,0,0">
                        <Button.IsEnabled>
                            <Binding Path="CurrentOrder.OrderStatus" Mode="OneWay" Converter="{StaticResource OrderStatusToCancelConverter}"/>
                        </Button.IsEnabled>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DestructiveButtonStyle}">
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <CheckBox x:Name="chkSms"
                             Content=" שלח סמס לשליח" 
                             Visibility="{Binding CurrentOrder.OrderStatus, Converter={StaticResource OrderStatusToVisibilityConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>