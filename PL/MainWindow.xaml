<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Height="600" Width="900" 
        Title="MainWindow" MinHeight="250" MinWidth="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="0" Grid.Column="0" >
            <Label Content="חנות הספרים שלי" Padding="5" Width="220"/>
            <TextBlock Text="{Binding SystemCurrentTime}" Padding="10,5"  TextWrapping="NoWrap" Width="245" FontSize="12"/>

            <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Content="+" Height="Auto" Click="MinutePlus_Click" BorderThickness="0" />
                <Label Grid.Column="1" Grid.Row="0" Content="דקה"  Background="#FFDDDDDD" />
                <Button Grid.Column="2" Grid.Row="1" Content="-" Height="Auto" Click="MinuteMinus_Click" BorderThickness="0" />

            </Grid>

            <Grid Grid.Column="1" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Content="+" Height="Auto" Click="HourPlus_Click" BorderThickness="0" />
                <Label Grid.Column="1" Grid.Row="0" Content="שעה" Background="#FFDDDDDD" />
                <Button Grid.Column="2" Grid.Row="1" Content="-" Height="Auto" Click="HourMinus_Click"  BorderThickness="0"/>

            </Grid>
            <Grid Grid.Column="1" Grid.Row="1" Background="#FFF1F0F0"  Margin="5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Column="0" Grid.Row="0" Content="+" Height="Auto" Click="YearPlus_Click" BorderThickness="0"/>
                <Label Grid.Column="1" Grid.Row="0" Content="שנה"  Background="#FFDDDDDD" />

            </Grid>

        </WrapPanel>
        <Grid Grid.Column="0" Grid.Row="1" Margin="20">
            <ScrollViewer>
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBox">
                            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
                            <EventSetter Event="TextChanged" Handler="TextBox_TextChanged"/>
                            <EventSetter Event="LostFocus" Handler="TextBox_LostFocus"/>
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </Style>
                    </StackPanel.Resources>
                    <TextBlock Text="עריכת הגדרות מערכת" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Label Content="מזהה מנהל:"/>
                    <TextBox Text="{Binding AdminConfig.ManagerId, Mode=TwoWay }"
                             PreviewTextInput="NumberValidationTextBox"
                             MaxLength="9"
                             Margin="0,0,0,10"/>

                    <Label Content="כתובת חנות:"/>
                    <TextBox Text="{Binding AdminConfig.StoreAddress, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="קו רוחב:"/>
                    <TextBox Text="{Binding AdminConfig.Latitude, Mode=TwoWay}" Margin="0,0,0,10" IsReadOnly="True"/>

                    <Label Content="קו אורך:"/>
                    <TextBox Text="{Binding AdminConfig.Longitude, Mode=TwoWay}" Margin="0,0,0,10" IsReadOnly="True"/>

                    <Label Content="מהירות רכב (קמ״ש):"/>
                    <TextBox Text="{Binding AdminConfig.AvgSpeedCar, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="מהירות אופונוע (קמ״ש):"/>
                    <TextBox Text="{Binding AdminConfig.AvgSpeedMotorcycle, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="מהירות אופניים (קמ״ש):"/>
                    <TextBox Text="{Binding AdminConfig.AvgSpeedBike, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="מהירות הליכה (קמ״ש):"/>
                    <TextBox Text="{Binding AdminConfig.AvgSpeedFoot, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="זמן משלוח מקסימלי (ימים:שעות):"/>
                    <TextBox Text="{Binding AdminConfig.MaxDeliveryTime, StringFormat=dd\\:hh, Mode=TwoWay}" Margin="0,0,0,10"/>

                    <Label Content="טווח סיכון (ימים:שעות):"/>
                    <TextBox Text="{Binding AdminConfig.RiskRange, StringFormat=dd\\:hh, Mode=TwoWay}" Margin="0,0,0,10" />

                    <Label Content="זמן חוסר פעילות לשליח (ימים.שעות):"/>
                    <TextBox Text="{Binding AdminConfig.MaxDeliveryTime, StringFormat=dd\\:hh, Mode=TwoWay}" Margin="0,0,0,10"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>


    </Grid>
</Window>
