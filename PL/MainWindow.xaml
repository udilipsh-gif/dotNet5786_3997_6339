<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="כניסה למערכת"
        Height="650" Width="650" 
        MinHeight="620" MinWidth="800" 
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Close">

    <Grid ShowGridLines="False">

        <Grid.Background>
            <ImageBrush ImageSource="/Images/image_login.png" Stretch="UniformToFill">
                <ImageBrush.RelativeTransform>
                    <ScaleTransform ScaleX="-1" CenterX="0.5" />
                </ImageBrush.RelativeTransform>
            </ImageBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="1.9*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
               Language="he-IL" 
               Text="{Binding CurrentTime}" 
               HorizontalAlignment="Center" 
               Foreground="{StaticResource PrimaryDarkColor}"
               FontWeight="Bold"
                   FontSize="20"
               Margin="10"/>

        <Border Grid.Row="1" 
                Width="300"
                VerticalAlignment="Top"
                Background="#50CCCCCC"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">
            <!--  זה ירד מהבורדר של שורה 1 כמו כן הפדינג היה 25-->
            <!--Background="{StaticResource SurfaceColor}"-->

            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000"/>
            </Border.Effect>

            <StackPanel>
                <Border Grid.Row="2"
                        Background="{StaticResource PrimaryColor}" 
                        CornerRadius="12" 
                        Padding="10,4" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="0,5">

                    <TextBlock Text="תעודת זהות:" 
                               Foreground="White" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                </Border>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="9"
                         Background="#70CCCCCC"
                         
                       
                         local:Tools.NumericOnly="True"/>

                <Border Grid.Row="2"
                        Background="{StaticResource PrimaryColor}" 
                        CornerRadius="12" 
                        Padding="10,4" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="0,5">

                    <TextBlock Text="סיסמה:" 
                               Foreground="White" 
                               FontSize="14" 
                               FontWeight="SemiBold"/>
                </Border>
                <PasswordBox x:Name="UserPasswordBox" Background="#70CCCCCC">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                    
                                    Command="{Binding LoginCommand}" 
                                    CommandParameter="{Binding ElementName=UserPasswordBox}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <Button Content="התחבר" 
                        Margin="0,20,0,0"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=UserPasswordBox}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>