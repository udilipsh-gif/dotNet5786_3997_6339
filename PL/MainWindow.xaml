<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        Height="400" Width="600" 
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="כניסה"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Close"
        MinHeight="400" MinWidth="300">
    <Window.Resources>
        <!-- Style for labels: Center-aligned vertically, right-aligned horizontally -->
        <Style TargetType="Label" x:Key="UniformLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="24"   />
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>


        </Style>

        <!-- Style for text boxes: Center-aligned vertically, stretches horizontally -->
        <Style x:Key="CommonInputStyle" TargetType="Control">
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="FontSize" Value="20"/>


        </Style>

        <Style TargetType="TextBox" x:Key="UniformTextBox" BasedOn="{StaticResource CommonInputStyle}" />

        <Style TargetType="PasswordBox" x:Key="UniformPasswordBox" BasedOn="{StaticResource CommonInputStyle}"/>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/image_login.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>
        <!--<Label Grid.Row="0" Content="חנות הספרים שלי" Style="{StaticResource UniformLabel}"/>-->
        <Border Grid.Row="1" Width="200" Height="150"
                HorizontalAlignment="Center"
                
                VerticalAlignment="Center"
                Background="#50CCCCCC">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content=":תעודת זהות" FontSize="14" FontWeight="DemiBold"  Style="{StaticResource UniformLabel}"/>
                <TextBox Grid.Row="1" 
                         Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource UniformTextBox}"
                         MaxLength="9"
                         Background="#50CCCCCC"
                       
                         local:Tools.NumericOnly="True"/>

                <Label Grid.Row="2" Content=":סיסמה" FontSize="14" FontWeight="DemiBold"  Style="{StaticResource UniformLabel}"/>
                <PasswordBox Grid.Row="3" 
                         x:Name="UserPasswordBox" 
                          Background="#50CCCCCC"
                         
                         Style="{StaticResource UniformPasswordBox}">

                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                Command="{Binding LoginCommand}" 
                                CommandParameter="{Binding ElementName=UserPasswordBox}"/>
                    </PasswordBox.InputBindings>

                </PasswordBox>


                <Button Grid.Row="5" 
                        Content="התחבר" FontWeight="Bold" 
                        IsEnabled="{Binding LoginCommand}"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=UserPasswordBox}"
                         Background="#50CCCCCC"
                       
                        Width="100" Height="30"/>
            </Grid>
        </Border>
        <!--<Label Grid.Row="2" Language="he-IL" Content="{Binding CurrentTime}" Style="{StaticResource UniformLabel}"/>-->
        <Border Grid.Row="2" 
        HorizontalAlignment="Left" 
        VerticalAlignment="Bottom" 
        Background="#80000000" 
        BorderThickness="0" 
        Padding="10" 
                
        Margin="10,0,0,30">

            <Label Content="{Binding CurrentTime}" Language="he-IL" Style="{StaticResource UniformLabel}"
                   FontSize="12" Foreground="White"/>
        </Border>

    </Grid>
</Window>
