<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Height="600" Width="900" 
        Title="MainWindow" MinHeight="250" MinWidth="400">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <WrapPanel Grid.Row="0" Grid.Column="0" >
            <Label Content="חנות הספרים שלי" Padding="5" Width="220"/>
            <TextBlock Text="{Binding SystemCurrentTime}" Padding="10,2,0,0"  TextWrapping="NoWrap" Width="245" FontSize="12"/>
            <Button Content="דקה + " Height="20"/>
            <Button Content="דקה - " Height="20"/>
            <Button Content="שעה + " Height="20"/>
            <Button Content="שעה - " Height="20"/>
            <Button Content="שנה + " Height="20"/>
        </WrapPanel>

    </Grid>
</Window>
