<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="כניסה למערכת"
        Height="650" Width="650" 
        MinHeight="620" MinWidth="800" 
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Close">

    <Window.Resources>
        <Style x:Key="LoginFieldStyle" TargetType="Control">
            <Setter Property="Background" Value="#70CCCCCC"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template" Value="{StaticResource {x:Type TextBox}}"/>
        </Style>

        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Background" Value="#70CCCCCC"/>
        </Style>
        <Style x:Key="LoginTextStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#70CCCCCC"/>
        </Style>

    </Window.Resources>

    <Grid ShowGridLines="False">
        <Grid.Background>
            <ImageBrush ImageSource="/Images/image_login.png" Stretch="UniformToFill">
                <ImageBrush.RelativeTransform>
                    <ScaleTransform ScaleX="-1" CenterX="0.5" />
                </ImageBrush.RelativeTransform>
            </ImageBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="2.1*"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.3*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="{Binding CurrentTime}" 
                   HorizontalAlignment="Center" 
                   Foreground="White"
                   FontWeight="Bold"
                   FontSize="28"
                   Language="he-IL"
                   Margin="10">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="0" Color="Black" Opacity="0.8"/>
            </TextBlock.Effect>
        </TextBlock>

        <Border Grid.Row="1" 
                Width="300"
                VerticalAlignment="Top"
                Background="#50CCCCCC"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15,15,15,0">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000"/>
            </Border.Effect>

            <StackPanel>
                <Border Style="{StaticResource LabelPillStyle}">
                    <TextBlock Text="תעודת זהות:" Style="{StaticResource LabelTextStyle}"/>
                </Border>

                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="9"
                         Style="{StaticResource LoginTextStyle}"
                         local:Tools.MoveFocusTo="{Binding ElementName=UserPasswordBox}"
                         local:Tools.NumericOnly="True"/>

                <Border Style="{StaticResource LabelPillStyle}">
                    <TextBlock Text="סיסמה:" Style="{StaticResource LabelTextStyle}"/>
                </Border>

                <PasswordBox x:Name="UserPasswordBox" Margin="0,0,00,10"
                             Style="{StaticResource LoginPasswordStyle}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                    Command="{Binding LoginCommand}" 
                                    CommandParameter="{Binding ElementName=UserPasswordBox}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <Button Content="התחבר" 
                        Margin="0,20"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=UserPasswordBox}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>