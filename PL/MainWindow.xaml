<Window x:Class="PL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="כניסה למערכת"
        Height="450" Width="400" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Loaded="MainWindow_Loaded"
        Closed="MainWindow_Close">

    <Grid ShowGridLines="True">
        
        <Grid.Background>
            <ImageBrush ImageSource="/Images/image_login.png" Stretch="UniformToFill">
                <ImageBrush.RelativeTransform>
                    <ScaleTransform ScaleX="-1" CenterX="0.5" />
                </ImageBrush.RelativeTransform>
            </ImageBrush>
        </Grid.Background>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="" 
                   Style="{StaticResource HeaderTextStyle}"
                   Margin="0,40,0,20"/>

        <Border Grid.Row="1" 
                Width="300"
                VerticalAlignment="Top"
                Background="#50FFFFFF"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15">
            <!--  זה ירד מהבורדר של שורה 1 כמו כן הפדינג היה 25-->
            <!--Background="{StaticResource SurfaceColor}"-->

            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1" Color="#000"/>
            </Border.Effect>

            <StackPanel>
                <Label Content="תעודת זהות:"/>
                <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="9"
                         Background="#50CCCCCC"
                       
                         local:Tools.NumericOnly="True"/>

                <Label Content="סיסמה:" Margin="0,15,0,0"/>
                <PasswordBox x:Name="UserPasswordBox">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" 
                                    Command="{Binding LoginCommand}" 
                                    CommandParameter="{Binding ElementName=UserPasswordBox}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <Button Content="התחבר" 
                        Margin="0,25,0,0"
                        Command="{Binding LoginCommand}" 
                        CommandParameter="{Binding ElementName=UserPasswordBox}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="0" 
                   Language="he-IL" 
                   Text="{Binding CurrentTime}" 
                   HorizontalAlignment="Center" 
                   Foreground="{StaticResource SubTextColor}"
                   Margin="10"/>
    </Grid>
</Window>