<Window x:Class="PL.Courier.CourierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        mc:Ignorable="d"
        Title="CourierWindow"
        Height="520" Width="350"
        Loaded="CourierWindow_Loaded"
        Closed="CourierWindow_Closed"
        MinHeight="520" MinWidth="350">
    
    <Window.Resources>
        <Style TargetType="Label" x:Key="UniformLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="5"/>
        </Style> 

        <Style TargetType="TextBox" x:Key="UniformTextBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="UniformPasswordBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="CheckBox" x:Key="UniformCheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="UniformComboBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- שורה 0 -->
                <TextBox Grid.Row="0" Grid.Column="0" IsReadOnly="{Binding IsUpdateMode}" Text="{Binding CurrentCourier.Id, Mode=TwoWay}" 
                         PreviewTextInput="NumberValidationTextBox" MaxLength="9"  Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="0" Grid.Column="1" Content=":.ת.ז" Style="{StaticResource UniformLabel}"/>
                <!-- שורה 1 -->
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CurrentCourier.Name, Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="1" Grid.Column="1" Content=":שם" Style="{StaticResource UniformLabel}"/>

                <PasswordBox Grid.Row="2" Grid.Column="0" DataContext="{Binding CurrentCourier.Password, Mode=TwoWay}"
                             PasswordChanged="PasswordChanged" Style="{StaticResource UniformPasswordBox}"/>
                <Label Grid.Row="2" Grid.Column="1" Content=":סיסמה" Style="{StaticResource UniformLabel}"/>
                
                <!--שורה 2-->
                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding CurrentCourier.Phone, Mode=TwoWay}"
                         PreviewTextInput="NumberValidationTextBox" MaxLength="10" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="3" Grid.Column="1" Content=":טלפון" Style="{StaticResource UniformLabel}"/>
                <!--שורה 3-->
                <TextBox Grid.Row="4" Grid.Column="0" Text="{Binding CurrentCourier.Email, Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="4" Grid.Column="1" Content=":דוא״ל" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="5" Grid.Column="0" Text="{Binding CurrentCourier.MaxDistanceDelivery, Mode=TwoWay}"
                         PreviewTextInput="NumberValidationTextBox" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="5" Grid.Column="1" Content=":מרחק מקסימלי לשילוח" Style="{StaticResource UniformLabel}"/>

                <ComboBox Grid.Row="6" Grid.Column="0" ItemsSource="{Binding VehicleTypesList}" SelectedItem="{Binding CurrentCourier.TypeShipment, Mode=TwoWay}" Style="{StaticResource UniformComboBox}"/>
                <Label Grid.Row="6" Grid.Column="1" Content=":סוג התניידות" Style="{StaticResource UniformLabel}"/>

                <CheckBox Grid.Row="7" Grid.Column="0" IsChecked="{Binding CurrentCourier.Active, Mode=TwoWay}" Style="{StaticResource UniformCheckBox}"/>
                <Label Grid.Row="7" Grid.Column="1" Content=":סטטוס שליח" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="8" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentCourier.WorkingSince, StringFormat='{}{0:dd.MM.yyyy}', Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="8" Grid.Column="1" Content=":פעיל החל מ" Style="{StaticResource UniformLabel}"/>

                <TextBox Grid.Row="9" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentCourier.DeliveryOnTime, Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="9" Grid.Column="1" Content=":מספר משלוחים בזמן" Style="{StaticResource UniformLabel}"/>


                <TextBox Grid.Row="10" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentCourier.DeliveryLate, Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="10" Grid.Column="1" Content=":מספר משלוחים באיחור" Style="{StaticResource UniformLabel}"/>


                <TextBox Grid.Row="11" Grid.Column="0" IsReadOnly="True" Text="{Binding CurrentCourier.OrderInProgress, Mode=TwoWay}" Style="{StaticResource UniformTextBox}"/>
                <Label Grid.Row="11" Grid.Column="1" Content=":מספר משלוח נוכחי" Style="{StaticResource UniformLabel}"/>

                <StackPanel Grid.Row="12"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">

                    <Button Content="{Binding ButtonText}"
                        Click="btnAddUpdate_Click"
                        Height="30"
                        Width="100"
                        Margin="5"/>

                    <Button Content="מחיקה"
                        Click="btnDelete_Click"
                        Height="30"
                        Width="100"
                        Margin="5"
                        Background="Red"
                        Visibility="{Binding DeleteButtonVisibility}"/>
                </StackPanel>



            </Grid>
        </ScrollViewer>

    </Grid>
</Window>