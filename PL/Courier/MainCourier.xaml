<Window x:Class="PL.MainCourier"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PL"
        Title="האזור האישי - שליח" 
        FlowDirection="RightToLeft"
        Height="700"
        SizeToContent="Width"
        WindowStartupLocation="CenterScreen"
        Loaded="MainCourier_Loaded"
        Closed="MainCourier_Closed"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="354"/>
            <ColumnDefinition Width="Auto" MinWidth="507.333"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SurfaceColor}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" 
                Margin="20,0,20,0" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="הפרטים שלי" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="1" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="שם:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentUser.Name}" 
                                   Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="טלפון:"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentUser.Phone}" 
                                   Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="אימייל:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentUser.Email}" 
                                    Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="סטטוס:"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" 
                                    Text="{Binding CurrentUser.Active, Converter={StaticResource BooleanToHebrewConverter}}"
                                    Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="כלי רכב:"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentUser.TypeShipment, 
                            Converter={StaticResource EnumDescriptionConverter}}" 
                                   Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="מרחק מקסימלי:"/>
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding CurrentUser.MaxDistanceDelivery}" 
                                        Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>
                            <TextBlock Text=" KM" Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>
                        </StackPanel>

                        <Label Grid.Row="6" Grid.Column="0" Content="התחיל לעבוד:"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" 
                                   Text="{Binding CurrentUser.WorkingSince, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                    Style="{StaticResource ModernTextBlock}" FontWeight="Normal"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="דירוג:" VerticalAlignment="Top"/>
                        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="5">
                            <TextBlock Text="{Binding CurrentUser.DeliveryOnTime}" Foreground="Green" FontWeight="Bold" ToolTip="משלוחים בזמן"/>
                            <TextBlock Text=" / "/>
                            <TextBlock Text="{Binding CurrentUser.DeliveryLate}" Foreground="Red" FontWeight="Bold" ToolTip="משלוחים באיחור"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Padding="3"
                              Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel >
                        <Label Content="שם:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.Name, Mode=TwoWay}" Margin="0,2"/>

                        <Label Content="תעודת זהות:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.Id}" Margin="0,2"
                              IsReadOnly="True"/>

                        <Label Content="טלפון:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.Phone, Mode=TwoWay}" Margin="0,2" local:Tools.NumericOnly="True" MaxLength="10"/>

                        <Label Content="מייל:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.Email, Mode=TwoWay}" Margin="0,2"/>

                        <Label Content="סיסמה:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.Password, Mode=TwoWay}" Margin="0,2"/>

                        <Label Content="רכב:" Margin="0,2"/>
                        <ComboBox ItemsSource="{Binding VehicleTypesList}" 
                              Style="{StaticResource ModernComboBox}"
                              SelectedItem="{Binding CurrentUser.TypeShipment, Mode=TwoWay}" Margin="0,2">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Label Content="מרחק מירבי למשלוח:" Margin="0,2"/>
                        <TextBox Text="{Binding CurrentUser.MaxDistanceDelivery, Mode=TwoWay}" 
                                     local:Tools.NumericOnly="True" MaxLength="2" Margin="0,2"/>
                    </StackPanel>
                </ScrollViewer>



                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <Button Content="יציאה למשלוח חדש" 
                                Click="StartDelivery_Click" 
                                Visibility="{Binding CurrentUser.OrderInProgress, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}"
                                IsEnabled="{Binding CurrentUser.Active}"
                                Background="{StaticResource AccentColor}" Foreground="Black"/>

                        <Button Content="עריכת פרטים" Click="EditCureier_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="היסטוריית משלוחים" Click="CureierDeliveryHistory_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="שמירה" Click="btnSaveUpdate_Click" Width="100"/>
                        <Button Content="ביטול" Click="CloseCureierEdit_Click" Style="{StaticResource SecondaryButtonStyle}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" 
                Background="#E3F2FD" 
                BorderBrush="{StaticResource PrimaryColor}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="15"
                Visibility="{Binding CurrentUser.OrderInProgress, Converter={StaticResource NullToVisibilityConverter}}" Margin="3,0,0,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="משלוח פעיל" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel>
                        <Label Content="כתובת יעד:" Foreground="#555"/>
                        <TextBlock Text="{Binding CurrentUser.OrderInProgress.Address}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="5,0,0,10"/>

                        <Grid  Grid.Row="0" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="לקוח:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.CustomerName}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="טלפון:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.CustomerPhone}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="מזהה הזמנה:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.OrderId}" FontWeight="SemiBold"/>
                            </StackPanel>

                        </Grid>
                        <Grid  Grid.Row="1" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="סוג הזמנה:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.TypeOfOrder,  Converter={StaticResource EnumDescriptionConverter}}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="מרחק אווירי:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.Distance, StringFormat=N2}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="מרחק בפועל:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.ActualDistance, StringFormat=N2}" FontWeight="SemiBold"/>
                            </StackPanel>

                        </Grid>
                        <Grid  Grid.Row="2" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="זמן פתיחת הזמנה:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.OrderTime}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="זמן תחילת משלוח:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.StartDeliveryTime}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="זמן אספקה צפוי:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.EstimatedDeliveryTime}" FontWeight="SemiBold"/>
                            </StackPanel>

                        </Grid>
                        <Grid  Grid.Row="3" Margin="0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="סטטוס הזמנה:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.OrderStatus, Converter={StaticResource EnumDescriptionConverter}}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="זמן מירבי למשלוח:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.MaxDeliveryTime}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="סטטוס עמידה בזמנים:"/>
                                <TextBlock Text="{Binding CurrentUser.OrderInProgress.ScheduleStatus, Converter={StaticResource EnumDescriptionConverter} }"  FontWeight="SemiBold"/>
                            </StackPanel>

                        </Grid>



                        <Label Content="הערות למשלוח:" Foreground="#555"/>
                        <TextBlock Text="{Binding CurrentUser.OrderInProgress.Details}" Background="White" Padding="10" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="נותר: "/>
                            <TextBlock Text="{Binding CurrentUser.OrderInProgress.TimeRemaining, StringFormat='{}{0:dd\\:hh\\:mm}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="3" Content="✅ סיום ודיווח משלוח" Click="ReportDelivery_Click" Height="50" FontSize="16" Margin="0,20,0,0"/>
            </Grid>
        </Border>



    </Grid>
</Window>