<Window x:Class="PL.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="רשימת שליחים" 
        Height="550" Width="750"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Close">

    <Window.Resources>
        <local:CourierFieldFilter x:Key="CourierFieldFilterKey" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ניהול שליחים" Style="{StaticResource HeaderTextStyle}"/>

            <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Label Content="סינון לפי סטטוס:" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold"/>

                    <ComboBox Width="200"
                      Style="{StaticResource ModernComboBox}"
                      ItemsSource="{Binding Source={StaticResource CourierFieldFilterKey}}" 
                      SelectedItem="{Binding CourierFilter}"
                      SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  x:Name="CourierGrid"
                  ItemsSource="{Binding CourierInList}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  FlowDirection="RightToLeft">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <EventSetter Event="MouseDoubleClick" Handler="DataGrid_MouseDoubleClick"/>
                </Style>
            </DataGrid.RowStyle>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="מזהה" Binding="{Binding Id}"/>

                <DataGridTextColumn Header="שם השליח" Binding="{Binding Name}"/>

                <DataGridTemplateColumn Header="סטטוס">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Active, Converter={StaticResource BooleanToHebrewConverter}}" 
                                       HorizontalAlignment="Center" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="{Binding Active, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="סוג כלי רכב" Binding="{Binding TypeShipment, Converter={StaticResource EnumDescriptionConverter}}"/>

                <DataGridTextColumn Header="תאריך הצטרפות" Binding="{Binding WorkingSince, StringFormat='{}{0:dd/MM/yyyy}'}"/>

                <DataGridTextColumn Header="בזמן" Binding="{Binding DeliveryOnTime}" Foreground="Green" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="באיחור" Binding="{Binding DeliveryLate}" Foreground="Red" FontWeight="SemiBold"/>

                <DataGridTextColumn Header="משלוח פעיל" Binding="{Binding DeliveryId}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" 
                Content="+ הוסף שליח חדש" 
                HorizontalAlignment="Right" 
                Width="180" 
                Margin="0,15,0,0"
                Command="{Binding AddCourierCommand}"/>
    </Grid>
</Window>