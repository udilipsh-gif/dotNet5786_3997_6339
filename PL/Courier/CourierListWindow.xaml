<Window x:Class="PL.Courier.CourierListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PL"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        DataContext="{Binding RelativeSource={RelativeSource Mode=Self}}"
        Title="CourierListWindow" Height="450" Width="650"
        Loaded="Window_Loaded"
        Closed="Window_Close">

    <Window.Resources>
        <local:CourierFieldFilter x:Key="CourierFieldFilterKey" />
    </Window.Resources>

    <!--External Grid-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="500*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!--Internal, Upper Grid-->
        <Grid HorizontalAlignment="Stretch" Height="auto" Grid.Row="0" VerticalAlignment="Stretch" Width="auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Label" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" 
                      ItemsSource="{Binding Source={StaticResource CourierFieldFilterKey}}" 
                      SelectedItem="{Binding CourierFilter}"
                      SelectionChanged="ComboBox_SelectionChanged"
                      SelectedIndex="0">
            </ComboBox>
        </Grid>
        
        <DataGrid AutoGenerateColumns="False" Margin="5" Grid.Row="1" ItemsSource="{Binding CourierInList}">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Id" 
                            Binding="{Binding Id}" 
                            SortMemberPath="Id" 
                            Width="Auto"/>

                <DataGridTextColumn Header="Name" 
                            Binding="{Binding Name}" 
                            SortMemberPath="Name" 
                            Width="Auto"/>

                <DataGridCheckBoxColumn Header="Is Active" 
                           Binding="{Binding Active}" 
                           SortMemberPath="Active"
                           IsReadOnly="True" 
                           Width="Auto"/>
                
                <DataGridTextColumn Header="TypeShipment" 
                            Binding="{Binding TypeShipment}" 
                            SortMemberPath="TypeShipment" 
                            Width="Auto"/>

                <DataGridTextColumn Header="Working Since" 
                            Binding="{Binding WorkingSince, StringFormat='{}{0:dd/MM/yyyy}'}" 
                            SortMemberPath="WorkingSince" 
                            Width="Auto"/>

                <DataGridTextColumn Header="DeliveryOnTime" 
                            Binding="{Binding DeliveryOnTime}" 
                            SortMemberPath="DeliveryOnTime" 
                            Width="Auto"/>

                <DataGridTextColumn Header="DeliveryLate" 
                            Binding="{Binding DeliveryLate}" 
                            SortMemberPath="DeliveryLate" 
                            Width="Auto"/>

                <DataGridTextColumn Header="DeliveryId" 
                            Binding="{Binding DeliveryId}" 
                            SortMemberPath="DeliveryId" 
                            Width="Auto"/>


            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Add" Grid.Row="2" HorizontalAlignment="Center" Height="Auto" Margin="10" Width="100"/>
    </Grid>
</Window>
